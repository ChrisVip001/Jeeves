{"id":"remember","description":"存事实：save_note 按序发出","message":"记住 alex 喜欢早会","responses":[{"tool_use":{"name":"memory","args":{"action":"save","subject":"alex","content":"喜欢早会"}}},{"text":"已经记下了，alex 喜欢早会。"}],"expect":{"tools_used":["memory"],"iterations":2,"reply_contains":["记下"]}}
