{"id": "memory-recall-across-sessions", "description": "A fact saved in one conversation is retrieved in another", "turns": [{"message": "remember that alex is allergic to peanuts", "session_id": "s1", "responses": [{"tool_use": {"name": "memory", "args": {"action": "save", "subject": "alex", "content": "allergic to peanuts"}}}, {"text": "Noted."}]}, {"message": "can alex eat peanut butter?", "session_id": "s2", "responses": [{"text": "Better not."}]}], "expect": {"last_prompt_contains": ["- **alex**: allergic to peanuts"]}}
{"id": "memory-correction-replaces-old", "description": "After a correction only the new wording is retrieved", "turns": [{"message": "remember alex likes morning meetings", "responses": [{"tool_use": {"name": "memory", "args": {"action": "save", "subject": "alex", "content": "likes morning meetings"}}}, {"text": "Noted."}]}, {"message": "correction: alex likes afternoon meetings", "responses": [{"tool_use": {"name": "memory", "args": {"action": "update", "id": 1, "content": "likes afternoon meetings"}}}, {"text": "Fixed."}]}, {"message": "when does alex like meetings?", "responses": [{"text": "Afternoons."}]}], "expect": {"last_prompt_contains": ["- **alex**: likes afternoon meetings"], "last_prompt_not_contains": ["- **alex**: likes morning meetings"]}}
{"id": "memory-forgotten-stays-forgotten", "description": "Forgetting a subject removes it, and distillation cannot bring it back", "settings": {"consolidate_every": 3}, "turns": [{"message": "remember alex likes tea", "responses": [{"tool_use": {"name": "memory", "args": {"action": "save", "subject": "alex", "content": "likes tea"}}}, {"text": "Noted."}]}, {"message": "forget everything about alex", "responses": [{"tool_use": {"name": "memory", "args": {"action": "forget", "subject": "alex"}}}, {"text": "Done."}]}, {"message": "ok, thanks", "responses": [{"text": "Any time."}, {"text": "{\"facts\": [{\"subject\": \"alex\", \"content\": \"likes tea\"}], \"episode\": \"small talk\"}"}]}, {"message": "what does alex like to drink?", "responses": [{"text": "I don't know."}]}], "expect": {"consolidation_new_facts": 0, "last_prompt_not_contains": ["- **alex**: likes tea", "(alex.md) · fact — likes tea"]}}
{"id": "memory-knowledge-update", "description": "A later statement replaces the earlier one it contradicts", "settings": {"consolidate_every": 2}, "turns": [{"message": "I live in Beijing", "responses": [{"text": "Nice."}]}, {"message": "good to know", "responses": [{"text": "Sure."}, {"text": "{\"facts\": [{\"subject\": \"user\", \"content\": \"lives in Beijing\"}], \"episode\": \"talked about home\"}"}]}, {"message": "I just moved to Shanghai", "responses": [{"text": "Congrats."}]}, {"message": "thanks", "responses": [{"text": "Sure."}, {"text": "{\"facts\": [{\"subject\": \"user\", \"content\": \"lives in Shanghai\", \"replaces\": [1]}], \"episode\": \"talked about the move\"}"}]}, {"message": "which city do I live in?", "responses": [{"text": "Shanghai."}]}], "expect": {"consolidation_new_facts": 2, "last_prompt_contains": ["- **user**: lives in Shanghai"], "last_prompt_not_contains": ["- **user**: lives in Beijing"]}}
{"id": "memory-recall-chinese-question", "description": "中文问句能检索到中文记忆", "turns": [{"message": "记住阿明对花生过敏", "session_id": "s1", "responses": [{"tool_use": {"name": "memory", "args": {"action": "save", "subject": "阿明", "content": "对花生过敏"}}}, {"text": "记下了。"}]}, {"message": "阿明能吃花生酱吗？", "session_id": "s2", "responses": [{"text": "最好别吃。"}]}], "expect": {"last_prompt_contains": ["- **阿明**: 对花生过敏"]}}
{"id": "memory-recall-paraphrase", "description": "A question worded differently from the memory still retrieves it", "known_gap": "E: retrieval is lexical only", "turns": [{"message": "remember I prefer green tea", "session_id": "s1", "responses": [{"tool_use": {"name": "memory", "args": {"action": "save", "subject": "user", "content": "prefers green tea"}}}, {"text": "Noted."}]}, {"message": "what beverage should you order for me?", "session_id": "s2", "responses": [{"text": "Green tea."}]}], "expect": {"last_prompt_contains": ["- **user**: prefers green tea"]}}
