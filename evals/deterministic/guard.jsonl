# 循环护栏：模型卡在重复/交替的工具调用里时要早停，而不是烧完迭代预算。
# 断言用 last_prompt_contains 而不是 tool_output_contains —— 护栏只改「喂回
# 模型的文本」（加提醒、把重复的长结果换引用桩），tool_calls 与 trace 里留的
# 仍是真结果。所以「模型确实看到了提醒」才是这条机制该被钉的地方。
{"id":"guard-stops-identical-repeats","description":"同一调用重复到第 3 次：模型在下一轮看到护栏提醒（用只读工具 search_memory —— save_note 现在会去重，第一次与后来的答复不同，恰好构不成「三次完全相同」）","responses":[{"tool_use":{"name":"memory","args":{"action":"search","query":"查不到的东西"}}},{"tool_use":{"name":"memory","args":{"action":"search","query":"查不到的东西"}}},{"tool_use":{"name":"memory","args":{"action":"search","query":"查不到的东西"}}},{"text":"我好像卡住了，先停下来。"}],"expect":{"tools_used":["memory","memory","memory"],"last_prompt_contains":["[guard]"],"reply_contains":["先停下来"]}}
{"id":"guard-catches-alternating-cycle","description":"A,B,A,B 交替重复：连续计数会被重置，必须靠周期判据抓到","responses":[{"tool_use":{"name":"memory","args":{"action":"list","limit":1}}},{"tool_use":{"name":"memory","args":{"action":"search","query":"fixed-missing-cycle-subject"}}},{"tool_use":{"name":"memory","args":{"action":"list","limit":1}}},{"tool_use":{"name":"memory","args":{"action":"search","query":"fixed-missing-cycle-subject"}}},{"text":"我在重复同一组调用，停下来汇报。"}],"expect":{"tools_used":["memory","memory","memory","memory"],"last_prompt_contains":["[guard]"],"reply_contains":["停下来汇报"]}}
{"id":"guard-advises-for-a-missing-target","description":"同一工具连续 3 次因目标不存在而失败：提醒要求停止猜路径，而不是通用的换条路","responses":[{"tool_use":{"name":"read_file","args":{"path":"{{home}}/notes/a.md"}}},{"tool_use":{"name":"read_file","args":{"path":"{{home}}/notes/b.md"}}},{"tool_use":{"name":"read_file","args":{"path":"{{home}}/notes/c.md"}}},{"text":"这几个文件都不存在，我先列一下目录。"}],"message":"读一下 notes 里的周报","expect":{"tools_used":["read_file","read_file","read_file"],"last_prompt_contains":["[guard]","Stop guessing names or paths"],"reply_contains":["列一下目录"]}}
{"id":"guard-keeps-generic-advice-for-mixed-causes","description":"连续失败的原因不一致：降级为通用提醒，不按最后一条报错给建议","files":{"notes/dir/keep.md":"x"},"message":"读一下 notes 里的周报","responses":[{"tool_use":{"name":"read_file","args":{"path":"{{home}}/notes/a.md"}}},{"tool_use":{"name":"read_file","args":{"path":"{{home}}/notes/dir"}}},{"tool_use":{"name":"read_file","args":{"path":"{{home}}/notes/c.md"}}},{"text":"读不到，先停下来说明。"}],"expect":{"tools_used":["read_file","read_file","read_file"],"last_prompt_contains":["[guard]","check the assumption behind it"],"last_prompt_not_contains":["Stop guessing names or paths"]}}
