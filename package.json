{
  "name": "jeeves",
  "private": true,
  "description": "Jeeves workspace for the Web app, channel adapters and browser executor.",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "web",
    "integrations/channels",
    "integrations/channels/runtime-client",
    "executors/browser"
  ],
  "scripts": {
    "test": "node --test --test-timeout=30000 \"web/test/*.test.*\" \"integrations/channels/test/*.test.*\" \"integrations/channels/runtime-client/test/*.test.*\" \"executors/browser/test/*.test.*\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "gateway:wechat": "node integrations/channels/src/bin-wechat.ts",
    "gateway:lark": "node integrations/channels/src/bin-lark.ts",
    "gateway:telegram": "node integrations/channels/src/bin-telegram.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^6.0.3"
  }
}
