# Jeeves's environment variable template.
#
# **Jeeves does not read this file.** The only config source is the process environment;
# `jeeves-config` reads it once at startup, immutable after. To use this, source it yourself:
#
#   cp .env.example .env
#   $EDITOR .env
#   set -a; source .env; set +a
#   jeeves
#
# To change config while running, use config/write (lands in <home>/settings.json, survives
# restarts), or just export. The authoritative reference for every variable is docs/configuration.md.
#
# Numeric knobs have bounds; **invalid values error out and exit at startup** (never silently
# default), and the error names the variable. Bounds table: docs/configuration.md "Invalid values fail at startup".
#
# Every item below is **commented out by default**: uncommented and changed is what you want.

# ---- Models ---------------------------------------------------------------
# Pick a provider (full list and default models in docs/configuration.md):
# anthropic / openai / deepseek / gemini / kimi / glm / minimax / xai /
# openrouter / opencode_zen / opencode_go / ollama
#JEEVES_PROVIDER=anthropic

# Keys and endpoints are **not** here: they live in <home>/models.json (`jeeves model add`,
# or the dashboard's Models panel). The per-vendor variables below are read targets a profile
# declares with `--env VAR`.

# Timeout for a single model call (seconds).
#JEEVES_LLM_TIMEOUT=120
# Retries on rate limits / transient failures (0 = off; every retry notifies you).
#JEEVES_LLM_RETRIES=2
# Anthropic Messages thinking for the main model (0 = model default). A manual budget
# must be at least 1024 and below the request output allowance.
#JEEVES_THINKING_BUDGET=0
# How many rounds a goal may auto-continue (/goal goals; past that, report honestly unfinished).
#JEEVES_GOAL_MAX_ROUNDS=5

# Models and keys are **not configured here**: /model add <name> <vendor> [--env VAR] [--key ...],
# or the dashboard's "Models" panel. The variables below are just read targets for Jeeves itself:
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#DEEPSEEK_API_KEY=
#GEMINI_API_KEY=
#MOONSHOT_API_KEY=      # kimi
#ZHIPU_API_KEY=         # glm
#MINIMAX_API_KEY=
#XAI_API_KEY=
#OPENROUTER_API_KEY=
#OPENCODE_ZEN_API_KEY=
#OPENCODE_GO_API_KEY=
# ollama needs no key (local inference, see docs/configuration.md)

# ---- State directory -----------------------------------------------------------
# state.db, SOUL.md, skills/, outbox/, traces/, settings.json all live in there.
#JEEVES_HOME=./.jeeves
# Tool payloads bigger than this are spilled to <home>/ledger/ instead of into the database (one row per turn
# should stay readable; a 200 KB command output should not).
#JEEVES_LEDGER_INLINE_MAX=32768
# Per-tenant caps for a hosted Runtime; 0 = no cap (the local default). Over the cap a new turn is
# refused with an error. JEEVES_HOME_MAX_MB is in megabytes.
#JEEVES_MAX_TURNS=0
#JEEVES_HOME_MAX_MB=0
# How many human-started tasks run side by side (1-8). Each holds a lease; a worker that stops
# renewing it is swept once. 1 = one at a time.
#JEEVES_TASK_WORKERS=1

# ---- Loop and memory --------------------------------------------------------
# Per-request output is fitted to the model catalog and remaining context.
# Use a positive value to apply a lower operator ceiling. 0 = automatic.
#JEEVES_MAX_TOKENS=0
# Working-memory sliding window (cap): older turns fold into a rolling summary (not dropped).
#JEEVES_HISTORY_TURNS=12
# Estimated context window (overrides the provider table's approximation); local models vary wildly.
#JEEVES_CONTEXT_WINDOW=
# Start compacting at this fraction of the window (tokens are the real gate; rounds are a cap).
#JEEVES_COMPACT_THRESHOLD=0.8
# How old a crashed turn's checkpoint may be before startup stops resuming it on its own (minutes).
# A checkpoint is crash recovery, so the honest window is seconds to minutes; past an hour "today"
# has moved and the intent has cooled. The stale turn is marked abandoned with one stderr line.
#JEEVES_RESUME_MAX_AGE=60
# In-turn tool-result budget: past the total, swap the largest for stubs (full text to disk). 0 = off.
#JEEVES_TOOL_RESULT_TOTAL_CHARS=200000
#JEEVES_TOOL_RESULT_MAX_CHARS=30000
# Distill facts every N turns.
#JEEVES_CONSOLIDATE_EVERY=6
#JEEVES_RETRIEVAL_TOP_K=4
# How many of the NEWEST tool results are never stubbed (trimming runs oldest-first).
#JEEVES_TOOL_RESULT_KEEP_RECENT=3
# Per-TURN token cap (input + output). At 80% the tools are taken away and the model wraps up.
# 0 = off (default): resource budgets remain available.
#JEEVES_TURN_TOKEN_BUDGET=0

# ---- Prompt shape (what the model sees every turn) ---------------------------------
# auto = thin for hosted models, full for ollama / lmstudio; a SOUL.md you edited wins either way.
#JEEVES_SOUL_MODE=auto
# The skill catalog always rides along (name + one line); bodies load on demand.
#JEEVES_SKILL_INDEX_TOKENS=200
#JEEVES_SKILL_BODY_TOKENS=1200
# eager = every tool schema in the request; deferred = always-on only, `find_tools` opens the rest.
#JEEVES_TOOL_POLICY=eager
# Percentage of the window at which the context meter shows a notice.
#JEEVES_CONTEXT_WARN_RATIO=85

# ---- Switches ---------------------------------------------------------------
# Task plans: one extra model call before the first round to split the work into rounds.
#JEEVES_PLAN=0

# ---- Command execution and writes (default off, see SECURITY.md)----------------------
# run_command joins the tool table only when on; with an empty allowlist nothing may run.
#JEEVES_EXEC=0
#JEEVES_EXEC_ALLOW=cargo test,git status,ls *
#JEEVES_EXEC_TIMEOUT=30
# The sandbox has no network by default (turn it on only for commands that need downloads).
#JEEVES_EXEC_NETWORK=0
# Extra writable directories (colon-separated, must be existing absolute paths); build caches.
#JEEVES_EXEC_WRITABLE_ROOTS=/Users/you/project/target
# Write tools (write_file / edit / apply_patch) join the table only when on; same boundary as exec.
#JEEVES_WRITE=0
# Directories whose writes need no confirmation in on-request mode (what "记住这条" writes for
# write_file/edit). A "don't ask again" list, NOT a writable root — outside the boundary nothing lands.
#JEEVES_WRITE_ALLOW_DIRS=/Users/you/project

# ---- Approvals (on-request only) ---------------------------------------------
# Whether to ask when nothing matches the allowlist (never / on-request). No answer = deny.
#JEEVES_APPROVAL=never
# Optional VAPID contact for Apple Web Push. Enroll each device separately in the cockpit.
#JEEVES_WEB_PUSH_CONTACT=
#JEEVES_APPROVAL_TIMEOUT=120

# ---- Hooks, routing, subagents, notifications -----------------------------------------
# Model routing force mode (auto|fixed). Default reads <home>/model-routes.json (default fixed).
#JEEVES_MODEL_ROUTE=
# Subagents (delegate_task): default off.
#JEEVES_DELEGATE=0
# Only when on is <home>/notify.json read ({"slack": "https://hooks.slack.com/services/…"}) and
# notifications pushed to the webhooks there: approval requests, background job completion, goal
# endings. Default off — sending data to external services is a decision made by the user's hand.
#JEEVES_NOTIFY=0

# ---- Tools and skills ---------------------------------------------------------
# Parallel MCP is the primary search/read service (anonymous, rate limited).
# Set 0 to use built-in web tools only. No paid credentials are used automatically.
#JEEVES_SEARCH_MCP=1
# Built-in fallback: Tavily/Brave with keys, otherwise DDG Lite then Bing HTML.
#TAVILY_API_KEY=
# Alternate name for the same key (takes precedence), for one prefix across everything.
#JEEVES_SEARCH_API_KEY=
# Second keyed backend in the chain (tried after Tavily).
#BRAVE_API_KEY=
# Cap the searches per turn (default 20) — a turn that searches forever is a loop.
#JEEVES_SEARCH_MAX_PER_TURN=20
# Set 0 to disable the keyless Bing backend (works on networks that block DDG).
#JEEVES_SEARCH_BING=1
# Set 0 to disable the keyless DuckDuckGo backend (the last fallback).
# With MCP off, both HTML backends off and no key, search_web is not registered.
#JEEVES_SEARCH_DDG=1
# Extra skill directories (colon-separated), for sharing community skill packs.
# Their skills are "built-in" in the dashboard's capability center: greyed out,
# read-only — the user's own <home>/skills always wins on a same name.
#JEEVES_SKILL_DIRS=
# Extra mcp.json files (colon-separated), for machine-wide MCP servers. Same
# story: built-in in the capability center, read-only; <home>/mcp.json wins.
#JEEVES_MCP_CONFIG=

# ---- Private Runtime and unified gateway -------------------------------------------------------
# Set to 0 for automatic port discovery with a loopback gateway.
#JEEVES_PORT=7777

#JEEVES_WEB_GATEWAY_URL=http://127.0.0.1:8743
# Which jeeves binary the TS client starts (defaults to looking in target/debug).
#JEEVES_BIN=

# Lark has its own rules for variables;
# see docs/configuration.md "Channel adapters" and docs/guide.md (allowlist, app secret).
#LARK_APP_ID=
#LARK_APP_SECRET=
# Attach to the private Runtime instead of starting another engine.
#JEEVES_GATEWAY_URL=http://127.0.0.1:7777
# Where the Runtime finds the Lark gateway script it hosts (the Docker image sets this).
#JEEVES_GATEWAY_BIN=
#LARK_ALLOW=
# Telegram gateway (`just gateway-telegram`): the token comes only from the environment.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_ALLOW=

# Overrides for the single-computer source launcher (just local-up).
#JEEVES_PERSONAL_HOME=
#JEEVES_PERSONAL_PORT=8743
# Set to 0 to print the entry without opening a browser after the owner is set up.
#JEEVES_PERSONAL_BROWSER=1

# ---- Private Runtime HTTP API ------------------------------------------------------
# Runtime bind address. Publish the Go gateway for browser access.
#JEEVES_OPS_HOST=127.0.0.1
# Private machine credential, required on every bind address. Alternative: an owner-only runtime-token file in JEEVES_HOME.
#JEEVES_OPS_TOKEN=
# Feishu/Lark sender ids (open_id) allowed to hand out tasks from a chat group; empty = nobody.
#JEEVES_DISPATCHERS=ou_xxx,ou_yyy

# Inbound webhooks (<home>/webhooks.json): a hook's `"secret": "env:JEEVES_HOOK_SECRET"` is resolved
# from the environment at request time, so the secret can stay out of the file.
#JEEVES_HOOK_SECRET=

# ---- Evals ---------------------------------------------------------------
# Which model judge-type evals use (defaults to the main model).
#JEEVES_JUDGE_MODEL=

# Optional self-contained browser components, prepared by `just browser-runtime`.
#JEEVES_BROWSER_RUNTIME=/absolute/path/to/browser-runtime
# Absolute path to the optional human-operated macOS window helper
# JEEVES_DESKTOP_HELPER=
# Mac app debug builds only: absolute path of the jeeves binary to start.
#JEEVES_DESKTOP_BINARY=
# Test/CI only: no visible window for human takeover.
#JEEVES_BROWSER_HEADLESS=0
# Allow attaching to an already open browser through a literal loopback CDP endpoint.
#JEEVES_BROWSER_CDP_ATTACH=0
# Refuse browser writes before approval; observation, navigation and scroll stay available.
#JEEVES_BROWSER_VIEW_ONLY=0
