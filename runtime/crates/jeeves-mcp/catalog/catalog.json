{
  "entries": [
    {
      "id": "calendar",
      "title": "CalDAV / ICS",
      "documentationUrl": "https://github.com/ChrisVip001/Jeeves/blob/main/docs/configuration.md",
      "setup": "builtin",
      "endpoint": null,
      "manifest": {
        "category": "calendar",
        "tools": {
          "calendar_list": {
            "effect": "read",
            "resource": "calendar"
          }
        },
        "verbs": {
          "calendar.list_events": "calendar_list"
        }
      }
    },
    {
      "id": "email",
      "title": "IMAP / SMTP",
      "documentationUrl": "https://github.com/ChrisVip001/Jeeves/blob/main/docs/configuration.md",
      "setup": "builtin",
      "endpoint": null,
      "manifest": {
        "category": "mail",
        "tools": {
          "email_read": {
            "effect": "read",
            "resource": "email"
          },
          "email_send": {
            "effect": "send",
            "resource": "email"
          }
        },
        "verbs": {
          "mail.send": "email_send"
        }
      }
    },
    {
      "id": "feishu",
